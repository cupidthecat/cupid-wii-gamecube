cmake_minimum_required(VERSION 3.28)
if(NOT DEFINED BUILD_DIR)
  message(FATAL_ERROR "Usage: cmake -DBUILD_DIR=<build-directory> -P tools/package-verify.cmake")
endif()
file(REAL_PATH "${BUILD_DIR}" BUILD_DIR)
if(NOT EXISTS "${BUILD_DIR}/CPackConfig.cmake")
  message(FATAL_ERROR "BUILD_DIR must contain a configured project")
endif()
include("${BUILD_DIR}/CPackConfig.cmake")
if(NOT DEFINED CPACK_CUPID_COMMIT OR CPACK_CUPID_COMMIT STREQUAL "")
  message(FATAL_ERROR "Package configuration must record the source revision")
endif()
set(expected_version "${CPACK_PACKAGE_NAME} ${CPACK_PACKAGE_VERSION} (${CPACK_CUPID_COMMIT})")
find_program(CUPID_CPACK cpack REQUIRED)
if(NOT DEFINED CONFIG)
  set(CONFIG Release)
endif()
execute_process(COMMAND "${CUPID_CPACK}" --config "${BUILD_DIR}/CPackConfig.cmake" -C "${CONFIG}"
  WORKING_DIRECTORY "${BUILD_DIR}" RESULT_VARIABLE pack_result)
if(NOT pack_result EQUAL 0)
  message(FATAL_ERROR "Package creation failed: ${pack_result}")
endif()
file(GLOB archives "${BUILD_DIR}/cupid-wii-gamecube-*.zip" "${BUILD_DIR}/cupid-wii-gamecube-*.tar.gz")
list(LENGTH archives archive_count)
if(NOT archive_count EQUAL 1)
  message(FATAL_ERROR "Expected one package archive; found ${archive_count}")
endif()
list(GET archives 0 archive)
string(TIMESTAMP verification_stamp "%Y%m%d%H%M%S")
set(verification_dir "${BUILD_DIR}/package-verification-${verification_stamp}")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${verification_dir}")
file(GLOB_RECURSE executables
  "${verification_dir}/cupid-wii-gamecube" "${verification_dir}/cupid-wii-gamecube.exe")
list(LENGTH executables executable_count)
if(NOT executable_count EQUAL 1)
  message(FATAL_ERROR "Package must contain exactly one runtime executable")
endif()
list(GET executables 0 executable)
foreach(notice IN ITEMS GPL-2.0-or-later.txt Zstd-BSD.txt bzip2.txt liblzma-0BSD.txt
    SDL2-zlib.txt SDL2-HIDAPI-BSD.txt SDL2-yuv2rgb-BSD.txt SDL2-libm.txt fmt-MIT.txt picojson-BSD.txt)
  file(GLOB_RECURSE notices "${verification_dir}/${notice}")
  if(NOT notices)
    message(FATAL_ERROR "Package is missing license notice ${notice}")
  endif()
endforeach()
foreach(argument IN ITEMS help version self-test)
  execute_process(COMMAND "${executable}" "--${argument}" WORKING_DIRECTORY "${verification_dir}"
    RESULT_VARIABLE run_result OUTPUT_VARIABLE run_output ERROR_VARIABLE run_error TIMEOUT 30)
  if(NOT run_result EQUAL 0)
    message(FATAL_ERROR "Packaged --${argument} failed: ${run_result}\n${run_output}\n${run_error}")
  endif()
  if(argument STREQUAL "version")
    string(STRIP "${run_output}" actual_version)
    if(NOT actual_version STREQUAL expected_version)
      message(FATAL_ERROR "Packaged version mismatch: expected '${expected_version}', got '${actual_version}'")
    endif()
  endif()
  message(STATUS "Packaged --${argument}: ${run_output}")
endforeach()
execute_process(COMMAND "${executable}" --self-test --cpu native
  WORKING_DIRECTORY "${verification_dir}" RESULT_VARIABLE native_result
  OUTPUT_VARIABLE native_output ERROR_VARIABLE native_error TIMEOUT 30)
if(native_result EQUAL 77)
  message(STATUS "Packaged native self-test skipped: ${native_output}")
elseif(NOT native_result EQUAL 0)
  message(FATAL_ERROR "Packaged native self-test failed: ${native_result}\n${native_output}\n${native_error}")
else()
  message(STATUS "Packaged native self-test: ${native_output}")
endif()
message(STATUS "Verified package: ${archive}")
